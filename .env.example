# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio WhatsApp (required in production)
# WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
# Must match the Twilio console webhook URL exactly (including https)
TWILIO_WEBHOOK_URL=

# App
NEXT_PUBLIC_APP_URL=

# Web Push (agent job alerts)
# Public key is safe in the client bundle. Private key is a secret — never commit it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:you@domain or https://your-app-url
VAPID_SUBJECT=

# n8n (unused in this version)
N8N_WEBHOOK_BASE_URL=
N8N_API_KEY=
